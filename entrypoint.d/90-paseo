#!/bin/sh
# Start the Paseo daemon alongside code-server.
#
# The base image entrypoint runs every executable in $ENTRYPOINTD (default
# /entrypoint.d) before it execs dumb-init + code-server, so this runs as the
# workspace user, before the IDE is up.
#
# Two rules this obeys:
#
#   1. Never block. code-server starts only after every hook returns, hence the
#      background launch.
#   2. Never exit non-zero. The base entrypoint runs hooks under `set -eu`, so a
#      failing hook aborts the container before code-server starts. Losing Paseo
#      must not lose the IDE: every problem is a warning and exit 0.
#
# Why `daemon run` and not `daemon start`: `start` is a managed launch, and
# daemonLaunchEnvironment() strips every DAEMON_SETTING_ENV_KEYS entry from the
# child environment — PASEO_LISTEN, PASEO_PASSWORD, PASEO_WEB_UI_ENABLED and
# friends would all be silently ignored. A container is a deployment, so the
# foreground mode is the one that honours the image's environment.
set -eu

export PASEO_LISTEN="${PASEO_LISTEN:-127.0.0.1:6767}"
export PASEO_WEB_UI_ENABLED="${PASEO_WEB_UI_ENABLED:-true}"

warn() {
    echo "[90-paseo] WARNING: $* — code-server continues without Paseo" >&2
    exit 0
}

command -v paseo >/dev/null 2>&1 || warn "paseo is not on PATH"

home="${PASEO_HOME:-${HOME}/.paseo}"
mkdir -p "${home}" 2>/dev/null || warn "cannot create PASEO_HOME ${home}"

# A home volume carried over from an earlier container brings its paseo.pid with
# it, and Paseo's own staleness test cannot see that. It compares the lock's
# bootId against /proc/sys/kernel/random/boot_id, which containers inherit from
# the host instead of getting per container, so a lock written by a previous
# container reads as "written during this boot". The pid it names has usually
# been recycled by then, and a recycled pid looks alive: this bit me with the
# lock naming a code-server thread, after which `daemon run` reported
# already_running and exited 0 without binding a port, silently.
#
# Ordered from what is certain to what is inferred:
#
#   no pid field    corruption; Paseo refuses to start over an unparseable record
#                   ("Invalid lock shape"), so leaving it means no daemon
#   no such pid     nothing owns the lock
#   endpoint answers a daemon is live and serving, leave it and launch nothing
#   argv[0] Paseo    live Paseo that is not listening yet, or is in another
#                   container sharing this home; argv[0] only, because a command
#                   line merely mentioning paseo proves nothing (the smoke test's
#                   own `sh -c` does)
#   otherwise        the pid was recycled; drop the lock and start
lock="${home}/paseo.pid"
if [ -f "${lock}" ]; then
    pid="$(sed -n -E 's/.*"pid":([0-9]+).*/\1/p' "${lock}")"
    listen="$(sed -n -E 's/.*"listen":"([^"]*)".*/\1/p' "${lock}")"
    host="${listen%%:*}"
    port="${listen##*:}"
    [ "${host}" = "${listen}" ] && host=""
    [ "${host}" = "0.0.0.0" ] && host="127.0.0.1"

    # Zero when something accepts a connection on the recorded endpoint.
    endpoint_answers() {
        case "${port}" in ''|*[!0-9]*) return 1 ;; esac
        CSP_HOST="${host:-127.0.0.1}" CSP_PORT="${port}" node -e '
const net = require("net");
const sock = net.connect({ host: process.env.CSP_HOST, port: Number(process.env.CSP_PORT) });
sock.setTimeout(1000);
sock.on("connect", () => process.exit(0));
sock.on("error", () => process.exit(1));
sock.on("timeout", () => { sock.destroy(); process.exit(1); });
' >/dev/null 2>&1
    }

    case "${pid}" in
        ''|*[!0-9]*)
            echo "[90-paseo] dropping unreadable lock: no pid field in ${lock}"
            rm -f "${lock}"
            ;;
        *)
            if [ ! -d "/proc/${pid}" ]; then
                echo "[90-paseo] dropping stale lock: pid ${pid} is not running"
                rm -f "${lock}"
            elif endpoint_answers; then
                echo "[90-paseo] a daemon already answers on ${listen}; not launching a second one"
                exit 0
            elif tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null | cut -d' ' -f1-2 | grep -qi paseo; then
                echo "[90-paseo] pid ${pid} already runs Paseo for ${home}; not launching a second daemon"
                exit 0
            else
                name="$(sed -n 's/^Name:[[:space:]]*//p' "/proc/${pid}/status" 2>/dev/null)"
                echo "[90-paseo] dropping stale lock: pid ${pid} is ${name:-unknown}, not Paseo"
                rm -f "${lock}"
            fi
            ;;
    esac
fi

# stdout is left attached so the daemon's own logs land in `docker logs`.
nohup paseo daemon run --home "${home}" &
echo "[90-paseo] paseo daemon launched on ${PASEO_LISTEN} (pid $!)"
