#!/bin/sh
# Start the Paseo daemon alongside code-server.
#
# The base image entrypoint runs every executable in $ENTRYPOINTD (default
# /entrypoint.d) before it execs dumb-init + code-server, so this runs as the
# workspace user, before the IDE is up.
#
# Two rules this obeys:
#
#   1. Never block. code-server starts only after every hook returns, hence the
#      background launch.
#   2. Never exit non-zero. The base entrypoint runs hooks under `set -eu`, so a
#      failing hook aborts the container before code-server starts. Losing Paseo
#      must not lose the IDE: every problem is a warning and exit 0.
#
# Why `daemon run` and not `daemon start`: `start` is a managed launch, and
# daemonLaunchEnvironment() strips every DAEMON_SETTING_ENV_KEYS entry from the
# child environment — PASEO_LISTEN, PASEO_PASSWORD, PASEO_WEB_UI_ENABLED and
# friends would all be silently ignored. A container is a deployment, so the
# foreground mode is the one that honours the image's environment.
set -eu

export PASEO_LISTEN="${PASEO_LISTEN:-127.0.0.1:6767}"
export PASEO_WEB_UI_ENABLED="${PASEO_WEB_UI_ENABLED:-true}"

warn() {
    echo "[90-paseo] WARNING: $* — code-server continues without Paseo" >&2
    exit 0
}

command -v paseo >/dev/null 2>&1 || warn "paseo is not on PATH"

home="${PASEO_HOME:-${HOME}/.paseo}"
mkdir -p "${home}" 2>/dev/null || warn "cannot create PASEO_HOME ${home}"

# stdout is left attached so the daemon's own logs land in `docker logs`.
nohup paseo daemon run --home "${home}" &
echo "[90-paseo] paseo daemon launched on ${PASEO_LISTEN} (pid $!)"
